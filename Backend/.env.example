//CONNECT STRING MONGODB
MONGODB_URI=mongodb+srv://orbitdatabase:orbitteamdatabase@cluster0.npc2upb.mongodb.net/orbit
FRONTED_URI=http://localhost:4321
FRONTEND_URI=http://localhost:4321
# Link trang đặt lại mật khẩu (dùng trong verify-reset-code)

# Gmail SMTP (dùng App Password, không dùng mật khẩu đăng nhập Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com
#KEY SECRET CODE JWT
JWT_SECRET=
IS_PRODUCTION=false

# Google OAuth 2.0 (Sign in with Google)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (dev) or your BACKEND_URL/api/auth/google/callback
BACKEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RabbitMQ (cho upload document background worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PACKAGE_UPLOAD_QUEUE=package_uploads

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=12345678
S3_BUCKET=orbit-documents
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# Redis cache (optional). If Redis is not running, omit REDIS_URL or set DISABLE_REDIS=1 to avoid connection errors.
# REDIS_URL=redis://localhost:6379
# DISABLE_REDIS=1

# IFC clash mesh (server narrow-phase vs AABB-only)
# Set to 1 to skip storing per-object triangle soup (lighter DB, AABB-only refinement).
# ORBIT_DISABLE_CLASH_MESH=0
# Max triangles per object after spatial subsampling (centroid grid + largest faces).
# ORBIT_CLASH_MESH_MAX_TRIS=80
# If federated object count exceeds this, clashMesh is stripped on import (Mongo ~16MB safety).
# ORBIT_MAX_OBJECTS_WITH_MESH=1200