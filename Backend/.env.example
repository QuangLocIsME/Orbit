//CONNECT STRING MONGODB
MONGODB_URI=mongodb+srv://orbitdatabase:orbitteamdatabase@cluster0.npc2upb.mongodb.net/orbit
FRONTED_URI=http://localhost:4321
FRONTEND_URI=http://localhost:4321
# Link trang đặt lại mật khẩu (dùng trong verify-reset-code)

# Gmail SMTP (dùng App Password, không dùng mật khẩu đăng nhập Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com
#KEY SECRET CODE JWT
JWT_SECRET=
IS_PRODUCTION=false

# Google OAuth 2.0 (Sign in with Google)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (dev) or your BACKEND_URL/api/auth/google/callback
BACKEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RabbitMQ (cho upload document background worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PACKAGE_UPLOAD_QUEUE=package_uploads
RABBITMQ_IFC_CONVERSION_QUEUE=ifc_to_xkt

# IFC worker
IFC_CONVERT_COMMAND=npx xeokit-convert
IFC_TEMP_DIR=/tmp/orbit-ifc-worker

# Storage (Supabase S3 protocol) - lưu IFC gốc
STORAGE_PROVIDER=supabase-s3
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=orbit-files
S3_FORCE_PATH_STYLE=true
# Set from Supabase S3 access keys
S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
S3_PUBLIC_URL=https://your-project-ref.storage.supabase.co/storage/v1/object/public
DEFAULT_FILE_FOLDER=file
DEFAULT_IMAGE_FOLDER=image
# Bucket for IFC mesh blobs. Defaults to S3_BUCKET. Prefix: navisworks-mesh/
# For local Docker MinIO (see docker-compose.yml), use the same bucket as mc mb, e.g. orbit-documents.
# ORBIT_MESH_BUCKET=orbit-documents

# IFC xeokit-convert server
XEOKIT_CONVERTER_URL=http://localhost:8099

# Supabase Storage (lưu XKT sau convert)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_XKT_BUCKET=xkt-models


# Navisworks workspace storage (mặc định: MongoDB only)
# Đặt thành 1 nếu muốn backup workspace.json ra disk song song với MongoDB
ORBIT_NAVISWORKS_SYNC_DISK=0
ORBIT_CLASH_MESH_MAX_TRIS=0
# Redis cache (optional). If Redis is not running, omit REDIS_URL or set DISABLE_REDIS=1 to avoid connection errors.
# REDIS_URL=redis://localhost:6379
# DISABLE_REDIS=1

# IFC clash mesh (server narrow-phase vs AABB-only)
# Quiets web-ifc console spam (e.g. TriangulateBounds / brep) during import — errors are often non-fatal.
# ORBIT_WEB_IFC_LOG=off

# Buffer "offset out of range" on IFC import was usually web-ifc treating vertex byte size as float count
# (patched in model.service.js). If import still fails, try ORBIT_DISABLE_CLASH_MESH=1 or ORBIT_CLASH_MESH_MAX_TRIS=80.
# Set to 1 to skip storing per-object triangle soup (lighter DB, AABB-only refinement).
# ORBIT_DISABLE_CLASH_MESH=0
# Max triangles per object after spatial subsampling (centroid grid + largest faces).
# Use 0 (or negative) for full IFC tessellation per element — larger Mongo docs, slower API/viewer.
# ORBIT_CLASH_MESH_MAX_TRIS=80
# Soft cap: warn only. Previously, exceeding this stripped clashMesh BEFORE MinIO upload, so large
# IFC models had no navisworks-mesh blob — every cross-model clash looked like 1 real mesh + 1 bbox.
# Mesh still uploads to MinIO; import memory may be higher for huge models. Use ORBIT_DISABLE_CLASH_MESH=1
# or ORBIT_CLASH_MESH_MAX_TRIS to reduce work instead.
# Default when unset is 1200 (warn only). Set 0 or negative to disable the warning (no cap / Infinity).
# ORBIT_MAX_OBJECTS_WITH_MESH=1200