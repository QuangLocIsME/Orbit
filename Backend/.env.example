//CONNECT STRING MONGODB
MONGODB_URI=mongodb+srv://orbitdatabase:orbitteamdatabase@cluster0.npc2upb.mongodb.net/orbit
FRONTED_URI=http://localhost:4321
FRONTEND_URI=http://localhost:4321
# Link trang đặt lại mật khẩu (dùng trong verify-reset-code)

# Gmail SMTP (dùng App Password, không dùng mật khẩu đăng nhập Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com
#KEY SECRET CODE JWT
JWT_SECRET=
IS_PRODUCTION=false

# Google OAuth 2.0 (Sign in with Google)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (dev) or your BACKEND_URL/api/auth/google/callback
BACKEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RabbitMQ (cho upload document background worker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PACKAGE_UPLOAD_QUEUE=package_uploads

# S3-compatible (Supabase Storage / AWS S3 / MinIO)
# Supabase S3 endpoint example: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=https://ufbkyxoefisgsjlpovou.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=orbit-files
S3_FORCE_PATH_STYLE=true
# Public URL base (for public bucket)
S3_PUBLIC_URL=https://ufbkyxoefisgsjlpovou.storage.supabase.co/storage/v1/object/public

# Logical top-level folders in storage keys
DEFAULT_FILE_FOLDER=file
DEFAULT_IMAGE_FOLDER=image

# Redis cache
REDIS_URL=redis://localhost:6379