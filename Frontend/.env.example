# Backend URL (dùng cho Vite proxy trong dev)
BACKEND_URL=http://localhost:3000

# Public API URL — exposed to browser, dùng cho tất cả API request
# Dev: trỏ thẳng đến backend (CORS đã được cấu hình)
# Prod: thay bằng URL thực của backend (vd: https://api.yourapp.com/api)
PUBLIC_API_URL=http://localhost:3000/api
