---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar';
import Header from '../components/layout/Header.astro';
import TopBar from '../components/layout/TopBar';
import InviteNotificationHandler from '../hooks/useInviteNotifications';
import { Toaster } from '../components/ui/sonner';

interface Props {
  title?: string;
  pageTitle?: string;
}

const { title, pageTitle = 'Home' } = Astro.props;
---

<BaseLayout title={title}>
  <script>
    import { navigate } from 'astro:transitions/client';
    import { hydrateApp, initAppSocket, clearAll } from '@/stores/appStore';

    // ── Auth event listeners ──────────────────────────────────────────────────
    window.addEventListener('orbit:auth-expired', () => navigate('/login'));
    window.addEventListener('orbit:sign-out', () => {
      clearAll();
      navigate('/login');
    });

    // ── SW Message Pipeline ───────────────────────────────────────────────────
    // SW delivers fresh data via postMessage (REFRESH_RESPONSE, GET_CACHED_RESPONSE).
    // We dispatch custom events so React components can patch their state directly
    // without triggering new fetches — this eliminates loading flicker.
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (event) => {
        const { type, payload } = event.data || {};

        // ── SYNC_SESSION: Legacy sessionStorage sync (projects/folders) ─────
        if (type === 'SYNC_SESSION') {
          const { key, data } = payload || {};
          if (key && data) {
            try { sessionStorage.setItem(key, JSON.stringify(data)); } catch (_) { /* ignore */ }
          }
        }

        // ── REFRESH_RESPONSE: Fresh data from SW background refresh ───────────
        // Route data format: full URL → extract path
        // e.g. "http://localhost:4321/api/projects/me" → "/api/projects/me"
        if (type === 'REFRESH_RESPONSE') {
          const route = payload?.route || '';
          const data = payload?.data;
          const isStale = payload?.isStale;

          if (!route || !data) return;

          // Extract path from full URL
          let path = route;
          try { path = new URL(route).pathname; } catch (_) { /* use as-is */ }

          // Dispatch a typed event that React components can listen to
          // This lets components patch state directly instead of re-fetching
          window.dispatchEvent(new CustomEvent('sw:data', {
            detail: { route: path, data, isStale },
          }));

          // Keep sessionStorage in sync for SSR/hydration
          if (path === '/api/projects/me' || path === '/api/folders/me') {
            const key = 'orbit:' + path.replace('/api/', '');
            const cachePayload = { data, expiresAt: Date.now() + 5 * 60 * 1000 };
            try { sessionStorage.setItem(key, JSON.stringify(cachePayload)); } catch (_) { /* ignore */ }
          }
        }

        // ── GET_CACHED_RESPONSE: On-demand cached data from SW ────────────────
        if (type === 'GET_CACHED_RESPONSE') {
          const route = payload?.route || '';
          const data = payload?.data;
          const isStale = payload?.isStale;

          if (!route || !data) return;

          let path = route;
          try { path = new URL(route).pathname; } catch (_) { /* use as-is */ }

          window.dispatchEvent(new CustomEvent('sw:data', {
            detail: { route: path, data, isStale },
          }));
        }

        // ── CLEAR_SESSION: Invalidate sessionStorage cache ────────────────────
        if (type === 'CLEAR_SESSION') {
          ['orbit:projects:me', 'orbit:folders:me'].forEach((key) => {
            try { sessionStorage.removeItem(key); } catch (_) { /* ignore */ }
          });
          window.dispatchEvent(new CustomEvent('sw:cleared'));
        }
      });
    }

    // ── Bootstrap: hydrate store + init socket ─────────────────────────────────
    hydrateApp();
    initAppSocket();

    // ── SW prefetch: cache critical routes on app boot ────────────────────────
    if (navigator.serviceWorker?.controller) {
      navigator.serviceWorker.controller.postMessage({
        type: 'PREFETCH_API',
        payload: { routes: ['/api/projects/me', '/api/folders/me'] },
      });
    }
  </script>
  <div class="flex h-screen flex-col overflow-hidden" transition:animate="none">
    <!-- Top Navigation Bar -->
    <div transition:persist transition:animate="none">
      <TopBar client:load currentPage={pageTitle} currentPath={Astro.url.pathname} />
    </div>

    <div class="flex flex-1 overflow-hidden" transition:animate="none">
      <aside transition:persist transition:animate="none">
        <Sidebar client:load currentPath={Astro.url.pathname} />
      </aside>
      <div class="flex flex-1 flex-col overflow-hidden" transition:animate="none">
        <header transition:persist transition:animate="none">
          <Header pageTitle={pageTitle} />
        </header>
        <main class="orbit-main-scroll flex-1 overflow-y-auto bg-background" transition:animate="none">
          <slot />
        </main>
      </div>
    </div>
  </div>
  <Toaster client:load />
  <InviteNotificationHandler client:load />
</BaseLayout>
