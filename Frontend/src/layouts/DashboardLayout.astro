---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/layout/Sidebar';
import Header from '../components/layout/Header.astro';
import TopBar from '../components/layout/TopBar';
import InviteNotificationHandler from '../hooks/useInviteNotifications';
import { Toaster } from '../components/ui/sonner';

interface Props {
  title?: string;
  pageTitle?: string;
}

const { title, pageTitle = 'Home' } = Astro.props;
---

<BaseLayout title={title}>
  <script>
    import { navigate } from 'astro:transitions/client';
    import { hydrateApp, initAppSocket, clearAll } from '@/stores/appStore';

    // ── Auth event listeners ──────────────────────────────────────────────────
    // Replace all hard window.location.href = '/login' calls with event-based
    // navigation so Astro's View Transitions pipeline stays intact.
    window.addEventListener('orbit:auth-expired', () => navigate('/login'));
    window.addEventListener('orbit:sign-out', () => {
      clearAll();
      navigate('/login');
    });

    // ── Bootstrap: hydrate store + init socket ─────────────────────────────────
    hydrateApp();
    initAppSocket();
  </script>
  <div class="flex h-screen flex-col overflow-hidden" transition:animate="none">
    <!-- Top Navigation Bar -->
    <div transition:persist transition:animate="none">
      <TopBar client:load currentPage={pageTitle} currentPath={Astro.url.pathname} />
    </div>

    <div class="flex flex-1 overflow-hidden" transition:animate="none">
      <aside transition:persist transition:animate="none">
        <Sidebar client:load currentPath={Astro.url.pathname} />
      </aside>
      <div class="flex flex-1 flex-col overflow-hidden" transition:animate="none">
        <header transition:persist transition:animate="none">
          <Header pageTitle={pageTitle} />
        </header>
        <main class="orbit-main-scroll flex-1 overflow-y-auto bg-background" transition:animate="none">
          <slot />
        </main>
      </div>
    </div>
  </div>
  <Toaster client:load />
  <InviteNotificationHandler client:load />
</BaseLayout>
