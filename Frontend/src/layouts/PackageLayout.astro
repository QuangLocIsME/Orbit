---
import ProjectTopBar from 'src/components/layout/ProjectTopBar';

interface Props {
  title?: string;
  projectName: string;
  projectSlug: string;
  packageName: string;
}

const { 
  title = 'ORBIT - Package Detail',
  projectName,
  projectSlug,
  packageName
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen font-sans bg-white">
    <!-- Project Top Bar with tabs -->
    <ProjectTopBar 
      projectName={projectName} 
      projectSlug={projectSlug} 
      packageName={packageName}
      client:load 
    />
    
    <!-- Main Content (no sidebar, centered with margins) -->
    <main class="min-h-[calc(100vh-130px)]">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
