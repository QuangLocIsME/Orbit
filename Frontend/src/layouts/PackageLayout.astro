---
import ProjectTopBar from '@/components/layout/ProjectTopBar';

interface Props {
  title?: string;
  projectName: string;
  projectSlug: string;
  packageName: string;
}

const {
  title = 'ORBIT - Package Detail',
  projectName,
  projectSlug,
  packageName
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen font-sans bg-[#F2F4F7]">
    <script>
      import { hydrateApp, initAppSocket, clearAll } from '@/stores/appStore';
      window.addEventListener('orbit:auth-expired', () => import('astro:transitions/client').then(m => m.navigate('/login')));
      window.addEventListener('orbit:sign-out', () => {
        clearAll();
        import('astro:transitions/client').then(m => m.navigate('/login'));
      });
      hydrateApp();
      initAppSocket();
    </script>
    <ProjectTopBar
      projectName={projectName}
      projectSlug={projectSlug}
      packageName={packageName}
      activeTab="packages"
      tabs={[
        { id: 'overview', label: 'Overview' },
        { id: 'packages', label: 'Packages' },
        { id: 'documents', label: 'Documents' },
        { id: 'versions', label: 'Versions' },
        { id: 'changes', label: 'Changes' },
        { id: 'tasks', label: 'Tasks' },
        { id: 'clashes', label: 'Clashes' },
        { id: 'teams', label: 'Teams' },
        { id: 'activity', label: 'Activity' },
        { id: 'settings', label: 'Settings' },
      ]}
      client:load
    />
    <main class="min-h-[calc(100vh-130px)] bg-[#F2F4F7] pt-[130px]">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
