---
import BaseLayout from './BaseLayout.astro';
import { Toaster } from '@/components/ui/sonner';
import InviteNotificationHandler from '@/hooks/useInviteNotifications';

interface Props {
  title?: string;
  projectName: string;
  projectSlug: string;
}

const {
  title = 'ORBIT - Project Management',
  projectName,
  projectSlug
} = Astro.props;
---

<BaseLayout title={title} bodyClass="bg-background">
  <script>
    import { navigate } from 'astro:transitions/client';
    import { hydrateApp, initAppSocket, clearAll } from '@/stores/appStore';

    window.addEventListener('orbit:auth-expired', () => navigate('/login'));
    window.addEventListener('orbit:sign-out', () => {
      clearAll();
      navigate('/login');
    });

    hydrateApp();
    initAppSocket();
  </script>
  <main data-project-name={projectName} data-project-slug={projectSlug}>
    <slot />
  </main>
  <Toaster client:load />
  <InviteNotificationHandler client:load />
</BaseLayout>
