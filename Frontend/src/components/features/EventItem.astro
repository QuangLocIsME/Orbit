---
import type { Event } from '@/types';
import { getRelativeDate, formatTime } from '@/lib/utils';

interface Props {
  event: Event;
}

const { event } = Astro.props;
const dateText = getRelativeDate(event.datetime);
const timeText = formatTime(event.datetime);
---

<div class="flex items-start gap-3 rounded-lg p-3 transition-colors hover:bg-accent/50">
  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
  </div>
  <div class="flex-1 min-w-0">
    <h4 class="text-sm font-medium text-foreground">{event.title}</h4>
    <p class="mt-0.5 text-xs text-muted-foreground">
      {dateText}, {timeText}
    </p>
    <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
      <span>{event.project}</span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        {event.attendees}
      </span>
    </div>
  </div>
</div>
