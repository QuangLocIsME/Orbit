---
interface Props {
  template: {
    id: string;
    name: string;
    description: string;
    author: string;
    isPrivate: boolean;
    tags: string[];
    stages: string[];
    downloads: number;
    rating: number;
  };
}

const { template } = Astro.props;

// Show first 4 stages, then +N
const visibleStages = template.stages.slice(0, 4);
const remainingStages = template.stages.length - 4;
---

<div class="group rounded-xl border border-gray-200 bg-white p-5 transition-all duration-200 hover:border-gray-300 hover:shadow-lg">
  <!-- Header -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h3 class="text-base font-semibold text-foreground truncate">{template.name}</h3>
        <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          {template.isPrivate ? 'Private' : 'Public'}
        </span>
      </div>
      
      <!-- Author -->
      <div class="mt-1 flex items-center gap-1.5">
        <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-[10px] font-medium text-white">
          {template.author.charAt(0).toUpperCase()}
        </div>
        <span class="text-sm text-muted-foreground">{template.author}</span>
      </div>
    </div>
  </div>

  <!-- Tags -->
  <div class="mt-3 flex flex-wrap gap-1.5">
    {template.tags.map((tag) => (
      <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">
        {tag}
      </span>
    ))}
  </div>

  <!-- Description -->
  <p class="mt-3 text-sm text-muted-foreground line-clamp-2">{template.description}</p>

  <!-- Stages -->
  <div class="mt-4">
    <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>{template.stages.length} stages</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {visibleStages.map((stage) => (
        <span class="inline-flex items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs text-gray-600">
          {stage}
        </span>
      ))}
      {remainingStages > 0 && (
        <span class="inline-flex items-center rounded-md border border-gray-200 bg-gray-50 px-2 py-0.5 text-xs text-gray-500">
          +{remainingStages}
        </span>
      )}
    </div>
  </div>

  <!-- Footer -->
  <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4">
    <div class="flex items-center gap-4">
      <!-- Downloads -->
      <div class="flex items-center gap-1 text-sm text-muted-foreground">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>{template.downloads}</span>
      </div>
      <!-- Rating -->
      <div class="flex items-center gap-1 text-sm text-muted-foreground">
        <svg class="h-4 w-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
        <span>{template.rating}</span>
      </div>
    </div>
    
    <!-- Use Template Button -->
    <button class="inline-flex items-center gap-1.5 rounded-lg border border-blue-600 bg-white px-3 py-1.5 text-sm font-medium text-blue-600 transition-all duration-150 hover:bg-blue-50 active:scale-95">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Use Template
    </button>
  </div>
</div>
