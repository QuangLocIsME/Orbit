---
import type { Project } from '@/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColors = {
  active: 'bg-green-500 text-white',
  review: 'bg-amber-500 text-white',
  paused: 'bg-gray-500 text-white',
  completed: 'bg-blue-500 text-white'
};

const typeConfig = {
  construction: { 
    label: 'Construction', 
    bgColor: 'bg-orange-100', 
    textColor: 'text-orange-600',
    icon: '🏗️'
  },
  design: { 
    label: 'Design', 
    bgColor: 'bg-green-100', 
    textColor: 'text-green-600',
    icon: '🎨'
  },
  software: { 
    label: 'Software', 
    bgColor: 'bg-cyan-100', 
    textColor: 'text-cyan-600',
    icon: '<>'
  },
  research: { 
    label: 'Research', 
    bgColor: 'bg-purple-100', 
    textColor: 'text-purple-600',
    icon: '🔬'
  }
};

const type = project.projectType || 'construction';
const typeInfo = typeConfig[type];

function getTimeAgo(dateStr: string) {
  const date = new Date(dateStr);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffMins = Math.floor(diffMs / (1000 * 60));
  
  if (diffMins < 60) return `${diffMins} minutes ago`;
  if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
  const diffDays = Math.floor(diffHours / 24);
  return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
}

const progressColor = project.progress && project.progress >= 75 
  ? 'bg-green-500' 
  : project.progress && project.progress >= 50 
    ? 'bg-blue-500' 
    : 'bg-indigo-500';
---

<a href={`/projects/${project.slug}`} class="group block">
  <div class="overflow-hidden rounded-xl border border-border bg-card transition-all hover:shadow-lg">
    <!-- Image Section -->
    <div class="relative h-48 overflow-hidden">
      <img 
        src={project.thumbnail} 
        alt={project.name}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
      
      <!-- Favorite Star -->
      {project.isFavorite && (
        <div class="absolute top-3 left-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-400 text-white shadow-md">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
        </div>
      )}
      
      <!-- Status Badge -->
      {project.status && (
        <div class="absolute top-3 right-3">
          <span class={`rounded-full px-3 py-1 text-xs font-medium ${statusColors[project.status]}`}>
            {project.status}
          </span>
        </div>
      )}
      
      <!-- Category Badge -->
      <div class="absolute bottom-3 left-3">
        <span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium ${typeInfo.bgColor} ${typeInfo.textColor}`}>
          {type === 'software' ? (
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          ) : type === 'design' ? (
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          ) : type === 'research' ? (
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          ) : (
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          )}
          {typeInfo.label}
        </span>
      </div>
    </div>
    
    <!-- Content Section -->
    <div class="p-4">
      <h3 class="text-base font-semibold text-card-foreground">{project.name}</h3>
      <p class="mt-1 text-sm text-muted-foreground line-clamp-1">{project.description}</p>
      
      <!-- Progress Bar -->
      {project.progress !== undefined && (
        <div class="mt-4">
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted-foreground">Progress</span>
            <span class="font-medium text-card-foreground">{project.progress}%</span>
          </div>
          <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
            <div 
              class={`h-full rounded-full ${progressColor} transition-all`}
              style={`width: ${project.progress}%`}
            />
          </div>
        </div>
      )}
      
      <!-- Stats -->
      <div class="mt-4 flex items-center gap-4 text-xs text-muted-foreground">
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span>{project.teamMembers || 0}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>{project.issues || 0}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{getTimeAgo(project.lastVisited)}</span>
        </div>
      </div>
    </div>
  </div>
</a>
