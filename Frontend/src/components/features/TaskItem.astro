---
import type { Task } from '@/types';
import { getRelativeDate } from '@/lib/utils';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  task: Task;
}

const { task } = Astro.props;

const priorityLabels = {
  high: 'High',
  medium: 'Medium',
  low: 'Low'
};
---

<div class="flex items-center justify-between rounded-lg p-3 transition-colors hover:bg-accent/50">
  <div class="min-w-0 flex-1">
    <h4 class="text-sm font-medium text-foreground">{task.title}</h4>
    <p class="mt-0.5 text-xs text-muted-foreground">
      {task.project} • {getRelativeDate(task.dueDate)}
    </p>
  </div>
  <Badge variant={task.priority}>
    {priorityLabels[task.priority]}
  </Badge>
</div>
