---
interface Props {
  name: string;
  color: 'blue' | 'cyan' | 'orange' | 'purple' | 'green' | 'pink' | 'gray' | 'red';
  projectCount: number;
}

const { name, color, projectCount } = Astro.props;

const colorClasses = {
  blue: 'text-blue-500',
  cyan: 'text-cyan-500',
  orange: 'text-orange-500',
  purple: 'text-purple-500',
  green: 'text-green-500',
  pink: 'text-pink-500',
  gray: 'text-gray-400',
  red: 'text-red-500'
};
---

<div class="group flex cursor-pointer items-center gap-3 rounded-lg border border-border bg-card p-4 transition-all hover:border-primary/30 hover:shadow-sm">
  <div class={`${colorClasses[color]}`}>
    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
      <path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
    </svg>
  </div>
  <div class="flex-1 min-w-0">
    <h3 class="text-sm font-medium text-card-foreground truncate">{name}</h3>
    <p class="text-xs text-muted-foreground">{projectCount} projects</p>
  </div>
</div>
