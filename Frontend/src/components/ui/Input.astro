---
import { cn } from '@/lib/utils';

interface Props {
  type?: string;
  placeholder?: string;
  class?: string;
  [key: string]: any;
}

const { type = 'text', class: className, ...props } = Astro.props;
---

<input
  type={type}
  class={cn(
    'flex h-11 w-full rounded-xl border border-gray-200 bg-background px-4 py-2.5 text-sm transition-all duration-150 placeholder:text-muted-foreground focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-50',
    className
  )}
  {...props}
/>
