---
import { cn } from '@/lib/utils';

interface Props {
  src?: string;
  alt?: string;
  fallback?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { src, alt = '', fallback, size = 'md', class: className } = Astro.props;

const sizes = {
  sm: 'h-8 w-8 text-xs',
  md: 'h-10 w-10 text-sm',
  lg: 'h-12 w-12 text-base',
};

const initials = fallback || alt?.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
---

<div class={cn(
  'relative flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-muted',
  sizes[size],
  className
)}>
  {src ? (
    <img src={src} alt={alt} class="aspect-square h-full w-full object-cover" />
  ) : (
    <span class="font-medium text-muted-foreground">{initials}</span>
  )}
</div>
