---
export const prerender = false;

import MainLayout from "../../../layouts/main-layout.astro";
import FolderBreadcrumb from "../../../modules/project/project-folder/component/folder-breadcrumb.jsx";
import FolderHeader from "../../../modules/project/project-folder/component/folder-header.jsx";
import ProjectHeader from "../../../modules/project/project-page/component/project-header.jsx";
import FolderProjectGrid from "../../../modules/project/project-folder/component/folder-project-grid.jsx";
import "../../../modules/project/project-page/style/project.css";
import "../../../modules/project/project-folder/style/folders.css";
import "../../../modules/project/project-page/style/create-project.css";
import "src/modules/project/project-folder/style/folder-page.css"
import "../../../modules/project/project-folder/style/create-folder.css";
const { id } = Astro.params;

// Fetch folder name
const folderRes = await fetch(new URL("/api/project-folder/folder", Astro.url.origin).href);
const folders = folderRes.ok ? await folderRes.json() : [];
const folder = folders.find((f: any) => String(f.id) === id);
const folderName = folder?.name ?? "Folder";
---

<MainLayout>
  <Fragment slot="head">
    <title>{folderName} — ORBIT</title>
  </Fragment>

  <main class="page-content">
    <div class="folder-page">
      <ProjectHeader client:load />
      <FolderBreadcrumb folderName={folderName} client:load />
      <FolderProjectGrid folderId={id} client:load />
    </div>
  </main>
</MainLayout>
