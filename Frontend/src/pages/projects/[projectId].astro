---
import MainLayout from "../../layouts/main-layout.astro";
import ProjectHeader from "../../components/project-overview/ProjectHeader.jsx";
import ProjectStats from "../../components/project-overview/ProjectStats.jsx";
import ProjectMembers from "../../components/project-overview/ProjectMembers.jsx";
import RecentActivity from "../../components/project-overview/RecentActivity.jsx";
import ProjectMilestones from "../../components/project-overview/ProjectMilestones.jsx";
import ProjectTabs from "../../components/project-overview/ProjectTabs.jsx";
import ProjectFigure from "../../components/project-overview/ProjectFigure.jsx";
import { Fragment } from "react";
import { getProject } from "../../services/projectService";

export const prerender = false;

const { projectId } = Astro.params;
const base = Astro.url.origin;

let project = null;
try {
  project = await getProject(projectId, base);
} catch (err) {
  console.error(err);
}
---


  <Fragment slot="head">
    <title>{project ? `${project.projectName} — ORBIT` : "Project — ORBIT"}</title>
    <link rel="stylesheet" href="/src/styles/folder-page.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-navigation.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-tabs.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-configure.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-stats.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-member.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/recent-activity.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-overview.css" />
    <link rel="stylesheet" href="/src/styles/project-overview/project-milestone.css" />
  </Fragment>

<main class="page-content">

  <ProjectHeader project={project} client:load />
  <ProjectTabs project={project} client:load />
  <ProjectFigure project={project} client:load />

  <div class="overview-container">

    <ProjectStats project={project} client:load />

    <div class="layout-grid">
      <ProjectMembers members={project.members || []} client:load />
      <RecentActivity activities={project.activities || []} client:load />
    </div>

    <ProjectMilestones milestones={project.milestones || []} client:load />

  </div>

</main>
