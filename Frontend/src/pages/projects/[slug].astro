---
export const prerender = false;
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import ProjectDetailPageClient from '@/components/features/ProjectDetailPageClient';

import projectsData from '@/data/projects.json';
import type { Project } from '@/types';

const publicId = Astro.params.slug ?? '';
const projects = projectsData as Project[];

// Ưu tiên match theo publicId (id), fallback theo slug cho link cũ
const matchedProject = projects.find((item) => item.id === publicId) ?? projects.find((item) => item.slug === publicId);

// Nếu project đến từ API và chưa có trong mock data, vẫn render detail theo publicId để không bị redirect
const project: Project = matchedProject ?? {
  id: publicId,
  name: `Project ${publicId}`,
  slug: publicId,
  thumbnail: '',
  lastVisited: new Date().toISOString(),
  category: 'shared',
  description: '',
  progress: 0,
  teamMembers: 0,
  issues: 0,
  status: 'active',
  projectType: 'software',
  isFavorite: false,
};
---

<ProjectLayout title={`${project.name} - ORBIT`} projectName={project.name} projectSlug={project.id}>
  <ProjectDetailPageClient project={project} client:load />
</ProjectLayout>
