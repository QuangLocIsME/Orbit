---
export const prerender = false;

import ProjectLayout from '@/layouts/ProjectLayout.astro';
import PackageDetailPage from '@/components/features/PackageDetailPage';

const backendUrl = import.meta.env.BACKEND_URL ?? 'http://localhost:3000';
const accessToken = Astro.cookies.get('accessToken')?.value;
const publicId = Astro.params.publicId as string;
const packageId = Astro.params.packageId as string;

if (!publicId || !packageId) {
  return Astro.redirect('/projects');
}

let project: any = null;

try {
  const res = await fetch(`${backendUrl}/api/projects/me`, {
    headers: {
      Cookie: `accessToken=${accessToken}`,
      Accept: 'application/json',
    },
    credentials: 'include',
  });

  if (res.ok) {
    const payload = await res.json();
    const projects: Array<Record<string, unknown>> = Array.isArray(payload?.data) ? payload.data : [];
    project = projects.find((p: Record<string, unknown>) => String(p.publicId) === publicId);
  }
} catch {
  // ignore and redirect below
}

if (!project) {
  return Astro.redirect('/projects');
}
---

<ProjectLayout
  title={`Package Detail - ${String(project.name)} - ORBIT`}
  projectName={String(project.name)}
  projectSlug={String(project.publicId)}
>
  <PackageDetailPage projectPublicId={publicId} packageId={packageId} client:load />
</ProjectLayout>
