---
// Project Detail Page — SSR: fetches real data server-side.
// Supports both authenticated users and guest access via share links (?guest=1&token=xxx).
export const prerender = false;
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import ProjectDetailPage from '@/components/features/ProjectDetailPage';

const backendUrl = import.meta.env.BACKEND_URL ?? 'http://localhost:3000';
const publicId = Astro.params.publicId as string;
const accessToken = Astro.cookies.get('accessToken')?.value;
const guestToken = Astro.url.searchParams.get('token');
const isGuest = Astro.url.searchParams.get('guest') === '1';

if (!publicId) {
  return Astro.redirect('/projects');
}

let project = null;
let guestAccess = null;
let error = null;

if (isGuest && guestToken) {
  // ── Guest access via share link ────────────────────────────────────────────
  try {
    const res = await fetch(`${backendUrl}/api/guest/project/${encodeURIComponent(publicId)}?token=${encodeURIComponent(guestToken)}`);
    if (res.ok) {
      const payload = await res.json();
      if (payload.success) {
        project = payload.data;
        guestAccess = { token: guestToken, isGuest: true };
      } else {
        error = payload.message || 'Share link is invalid or expired.';
      }
    } else if (res.status === 404) {
      error = 'Project not found or share link is no longer valid.';
    } else if (res.status === 410) {
      error = 'Share link has expired.';
    } else {
      error = 'Failed to load project.';
    }
  } catch {
    error = 'Failed to load project.';
  }
} else {
  // ── Authenticated user ─────────────────────────────────────────────────────
  try {
    const res = await fetch(`${backendUrl}/api/projects/me`, {
      headers: {
        Cookie: `accessToken=${accessToken}`,
        Accept: 'application/json',
      },
      credentials: 'include',
    });

    if (res.ok) {
      const payload = await res.json();
      const projects = Array.isArray(payload?.data) ? payload.data : [];
      project = projects.find((p) => String(p.publicId) === publicId);
    }
  } catch {
    error = 'Failed to load project';
  }

  if (!project) {
    return Astro.redirect('/projects');
  }
}

if (error) {
  return Astro.redirect(`/share/invalid?message=${encodeURIComponent(error)}`);
}
---

<ProjectLayout
  title={`${project.name} - ORBIT`}
  projectName={String(project.name)}
  projectSlug={String(project.publicId)}
>
  <ProjectDetailPage
    project={project}
    isGuest={isGuest}
    guestToken={guestToken}
    client:load
  />
</ProjectLayout>
