---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../components/auth/ForgotPasswordForm';
import { redirectIfAuthenticated } from '../lib/auth-page-guard';

const backendUrl = import.meta.env.BACKEND_URL ?? 'http://localhost:3000';
const accessToken = Astro.cookies.get('accessToken')?.value;

const redirected = await redirectIfAuthenticated({
  accessToken,
  backendUrl,
  redirect: (path) => Astro.redirect(path),
  to: '/home',
});

if (redirected) return redirected;
---

<BaseLayout title="Forgot Password - ORBIT" description="Reset your ORBIT account password">
  <ForgotPasswordForm client:load />
</BaseLayout>
