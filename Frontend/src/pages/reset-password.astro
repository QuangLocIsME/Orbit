---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ResetPasswordForm from '../components/auth/ResetPasswordForm';

// Decode base64 email from URL
function getEmailFromUrl() {
  const encoded = Astro.url.searchParams.get('email');
  if (!encoded) return '';
  try {
    return Buffer.from(encoded, 'base64').toString('utf8');
  } catch {
    return '';
  }
}

const token = Astro.url.searchParams.get('token') || '';
const email = getEmailFromUrl();
---

<BaseLayout title="Reset Password - ORBIT" description="Reset your ORBIT account password">
  <ResetPasswordForm token={token} email={email} client:load />
</BaseLayout>
