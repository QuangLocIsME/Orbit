---
import ProjectHeader from "../modules/project/project-page/component/project-header.jsx";
import FoldersSection from "../modules/project/project-folder/component/folders-section.jsx";
import PrioritySection from "../modules/project/project-detail/project-overview/component/priority-section.jsx";
import MainLayout from "../layouts/main-layout.astro";
import "/src/modules/project/project-folder/style/create-folder.css";
import "/src/modules/project/project-page/style/create-project.css";
import "/src/modules/project/project-page/style/project.css";
import "/src/modules/project/project-page/style/priority.css";
import "/src/modules/project/project-folder/style/folders.css";
---

<MainLayout>

  <Fragment slot="head">
    <title>Projects — ORBIT</title>
  </Fragment>

  <main class="page-content">

    <!-- PROJECT HEADER -->
    <ProjectHeader client:load />

    <!-- FOLDERS -->
    <FoldersSection client:load />

    <!-- PRIORITY PROJECTS -->
    <PrioritySection client:load />

  </main>

</MainLayout>
