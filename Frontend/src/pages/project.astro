---
import ProjectHeader from "../components/layout/project/project-header.jsx";
import FoldersSection from "../components/layout/project/folders-section.jsx";
import PrioritySection from "../components/layout/project/priority-section.jsx";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout>

  <Fragment slot="head">
    <title>Projects — ORBIT</title>
    <link rel="stylesheet" href="/src/styles/project.css" />
    <link rel="stylesheet" href="/src/styles/sidebar.css" />
    <link rel="stylesheet" href="/src/styles/topbar.css" />
    <link rel="stylesheet" href="/src/styles/folders.css" />
    <link rel="stylesheet" href="/src/styles/priority.css" />
    <link rel="stylesheet" href="/src/styles/create-folder.css" />
  </Fragment>

  <main class="page-content">

    <!-- PROJECT HEADER -->
    <ProjectHeader client:load />

    <!-- FOLDERS -->
    <FoldersSection client:load />

    <!-- PRIORITY PROJECTS -->
    <PrioritySection client:load />

  </main>

</MainLayout>
