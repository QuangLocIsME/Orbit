---
export const prerender = false;
import PackageLayout from '@/layouts/PackageLayout.astro';
import PackageDetailPage from '@/components/features/PackageDetailPage';

const packageId = Astro.params.slug || '';
---

<PackageLayout
  title="Package Detail - ORBIT"
  projectName="Project"
  projectSlug="projects"
  packageName="Package"
>
  <PackageDetailPage packageId={packageId} client:load />
</PackageLayout>
