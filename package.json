{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit monorepo launcher",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix Frontend\" \"node Backend/app.js\"",
    "frontend:dev": "npm run dev --prefix Frontend",
    "backend:dev": "node Backend/app.js",
    "build": "npm run build --prefix Frontend",
    "start": "node Backend/app.js"
  },
  "dependencies": {
    "concurrently": "^9.0.1"
  }
}
